@echo off
REM Glint CLI Wrapper - Auto-generated by build-and-run.bat
REM This script finds and executes the glint executable

setlocal

REM Find the glint executable (Release > RelWithDebInfo > MinSizeRel > Debug > fallbacks)
set GLINT_EXE=
if exist "%~dp0..\builds\desktop\cmake\Release\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\Release\glint.exe
) else if exist "%~dp0..\builds\desktop\cmake\RelWithDebInfo\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\RelWithDebInfo\glint.exe
) else if exist "%~dp0..\builds\desktop\cmake\MinSizeRel\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\MinSizeRel\glint.exe
) else if exist "%~dp0..\builds\desktop\cmake\Debug\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\Debug\glint.exe
) else if exist "%~dp0..\builds\desktop\cmake\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\glint.exe
) else if exist "%~dp0..\builds\desktop\cmake\bin\glint.exe" (
    set GLINT_EXE=%~dp0..\builds\desktop\cmake\bin\glint.exe
) else (
    echo ERROR: glint.exe not found. Please build the project first.
    echo Run: tools\build-and-run.bat
    exit /b 1
)

REM Preserve caller working directory for default init target and other relative inputs
set "GLINT_CALLER_CWD=%CD%"

REM Change to repository root for correct asset paths
cd /d "%~dp0.."

REM Execute glint with all arguments
"%GLINT_EXE%" %*

REM Preserve exit code
exit /b %ERRORLEVEL%
