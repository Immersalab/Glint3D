# glint_qem_studio_shell config v1
glint_executable=builds\desktop\cmake\Debug\glint.exe
mesh_path=tools/qem_simplifier/resources/models/bunny.obj
output_dir=tools/qem_simplifier/outputs
preview_preset_ops=tools/qem_simplifier/outputs/preview_preset.ops.json
preview_display_mode=wireframe_overlay
decomp_output_dir=tools/qem_simplifier/output/decomp
decomp_ffmpeg_executable=third_party/managed/ffmpeg/bin/ffmpeg.exe
decomp_every_collapses=500
decomp_fps=24
decomp_make_video=true
decomp_keep_obj_snapshots=false
